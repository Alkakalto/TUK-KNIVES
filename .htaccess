Options -Indexes
DirectoryIndex index.php index.html
RewriteEngine On
RewriteRule ^(?:app|database|bin|tests|docs|dev|vendor|Schedual)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^config(?:\..*)?\.php$ - [F,L,NC]
RewriteRule ^(?:en|EN)/knives\.html$ /catalog.php [R=302,L]
<FilesMatch "(?i)\.(sql|log|ini|bak|md|lock)$">
  Require all denied
</FilesMatch>
